{
  "name": "@fuzdev/zzz",
  "version": "0.0.1",
  "private": true,
  "description": "software garage for power users and devs",
  "tagline": "nice web things for the tired",
  "glyph": "💤",
  "logo": "logo.svg",
  "logo_alt": "three sleepy z's",
  "license": "0BSD",
  "homepage": "https://www.zzz.software/",
  "repository": "https://github.com/fuzdev/zzz",
  "author": {
    "name": "Ryan Atkinson",
    "email": "mail@ryanatkn.com",
    "url": "https://www.ryanatkn.com/"
  },
  "bugs": "https://github.com/fuzdev/zzz/issues",
  "funding": "https://www.ryanatkn.com/funding",
  "scripts": {
    "start": "cargo xtask dev",
    "dev": "cargo xtask dev",
    "dev:setup": "cargo xtask dev-setup",
    "prod:setup": "cargo xtask prod-setup",
    "build": "gro build",
    "check": "gro check",
    "typecheck": "gro typecheck",
    "test": "gro test",
    "test:cross": "FUZ_TEST_CROSS_BACKEND=1 vitest run --project cross_backend_rust --project cross_backend_rust_proxy",
    "preview": "vite preview",
    "deploy": "gro deploy",
    "serve": "gro build && npm run preview"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "peerDependencies": {
    "@fuzdev/fuz_app": ">=0.153.0",
    "@fuzdev/fuz_schema": "^0.5.0",
    "@fuzdev/fuz_ui": ">=0.221.0",
    "@fuzdev/fuz_util": ">=0.79.0",
    "@sveltejs/kit": "^3",
    "esm-env": "^1",
    "svelte": "^5",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "esm-env": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fuzdev/fuz_app": "^0.153.0",
    "@fuzdev/fuz_code": "^0.56.0",
    "@fuzdev/fuz_css": "^0.72.0",
    "@fuzdev/fuz_schema": "^0.5.0",
    "@fuzdev/fuz_ui": "^0.221.0",
    "@fuzdev/fuz_util": "^0.79.0",
    "@fuzdev/gro": "^0.223.0",
    "@fuzdev/mdz": "^0.7.0",
    "@ryanatkn/eslint-config": "^0.13.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.7",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.17.1",
    "esm-env": "^1.2.2",
    "jsdom": "^27.2.0",
    "pg": "^8.20.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.17.0",
    "svelte2tsx": "^0.7.55",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@xterm/xterm": "^6.0.0",
    "date-fns": "^4.1.0"
  },
  "sideEffects": [
    "**/*.css",
    "**/zzz_jsonrpc_errors.*"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    }
  }
}
