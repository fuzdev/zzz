# Development environment
# Copy to .env.development (or run: cargo xtask dev-setup)

# Runtime environment
NODE_ENV=development

# Zzz app directory (zzz's own files; reserved state/, cache/, run/ subdirs)
PUBLIC_ZZZ_DIR="./.zzz"

# Comma-separated filesystem paths Zzz can access (e.g., "./projects,/home/me/code";
# zzzd doesn't expand `~`)
PUBLIC_ZZZ_SCOPED_DIRS="./src/test/fs1,./src/test/fs2"

# Frontend SvelteKit env vars (used by $env/static/public in constants.ts)
PUBLIC_ZZZ_SERVER_PROTOCOL=http
PUBLIC_ZZZ_SERVER_HOST=localhost
PUBLIC_ZZZ_SERVER_PORT=5173
PUBLIC_ZZZ_SERVER_API_PATH="/api"
PUBLIC_ZZZ_WEBSOCKET_URL=ws://localhost:4461/api/ws
# The backend port Vite's dev proxy targets (read by vite.config.ts)
PUBLIC_ZZZ_SERVER_PROXIED_PORT=4461

# Database — PostgreSQL (the Rust backend connects via tokio-postgres)
DATABASE_URL=postgres://localhost/zzz

# Auth - cookie signing key, generated by `cargo xtask dev-setup`
# (or by hand: openssl rand -hex 32)
SECRET_FUZ_COOKIE_KEYS=

# Security - allowed origins for API requests
# Patterns: https://example.com, https://*.example.com, http://localhost:*
FUZ_ALLOWED_ORIGINS=http://localhost:*

# Bootstrap token path (for initial admin account creation)
FUZ_BOOTSTRAP_TOKEN_PATH=.zzz/bootstrap_token

# AI provider API keys (optional, for remote providers)
SECRET_OPENAI_API_KEY=
SECRET_ANTHROPIC_API_KEY=
SECRET_GOOGLE_API_KEY=

# Local tools (optional). `zzzd` finds `ffmpeg` and whisper.cpp's `whisper-cli`
# on its PATH; name one here (an absolute path) to use another. The speech
# model has no default: transcription is off until this names a model file
# (a `ggml-*.bin`, absolute path) you downloaded. zzz downloads none.
# ZZZ_FFMPEG_BIN=
# ZZZ_WHISPER_CPP_BIN=
# ZZZ_WHISPER_CPP_MODEL=
