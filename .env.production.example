# Production environment
# Copy to .env.production (or run: cargo xtask prod-setup). `gro build` reads its
# PUBLIC_ZZZ_* values; zzzd loads no env file, so supply the server values
# through its environment (see docs/development.md).

# Zzz app directory (zzz's own files; reserved state/, cache/, run/ subdirs)
PUBLIC_ZZZ_DIR="./.zzz"

# Comma-separated filesystem paths Zzz can access (zzzd doesn't expand `~`)
PUBLIC_ZZZ_SCOPED_DIRS=

# Server port — zzzd reads --port / ZZZ_PORT (default 4460) and always
# binds loopback (no HOST override)
# ZZZ_PORT=4460

DATABASE_URL=postgres://localhost/zzz

# Auth - cookie signing key, generated by `cargo xtask prod-setup`
# (or by hand: openssl rand -hex 32)
SECRET_FUZ_COOKIE_KEYS=

# Security - allowed origins for API requests (required, non-empty)
FUZ_ALLOWED_ORIGINS=http://localhost:*

# Bootstrap token path (for initial admin account creation)
# FUZ_BOOTSTRAP_TOKEN_PATH=.zzz/bootstrap_token

# Frontend SvelteKit env vars (baked in at build time via $env/static/public in
# constants.ts — each must be present, even if empty). Left empty, the server
# and WebSocket URLs are the page's own origin, so the UI works on whatever
# host and port zzzd serves it from.
PUBLIC_ZZZ_SERVER_PROTOCOL=
PUBLIC_ZZZ_SERVER_HOST=
PUBLIC_ZZZ_SERVER_PORT=
PUBLIC_ZZZ_SERVER_API_PATH="/api"
PUBLIC_ZZZ_WEBSOCKET_URL=

# AI provider API keys (optional, for remote providers)
SECRET_OPENAI_API_KEY=
SECRET_ANTHROPIC_API_KEY=
SECRET_GOOGLE_API_KEY=

# Local tools (optional). `zzzd` finds `ffmpeg` and whisper.cpp's `whisper-cli`
# on its PATH; name one here (an absolute path) to use another. The speech
# model has no default: transcription is off until this names a model file
# (a `ggml-*.bin`, absolute path) you downloaded. zzz downloads none.
# ZZZ_FFMPEG_BIN=
# ZZZ_WHISPER_CPP_BIN=
# ZZZ_WHISPER_CPP_MODEL=
